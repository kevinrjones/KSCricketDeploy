# =============================================================================
# ACS Deploy - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to git - it contains secrets!
# =============================================================================

# ---- Image Tags ----
# Pin to specific sha tags for production, use 'latest' for beta/testing
IDS_IMAGE=knowledgespike/ids:latest
ADMINUI_IMAGE=knowledgespike/adminui:latest
ACS_WEB_IMAGE=knowledgespike/acs-cricketarchive-web:latest
ACS_API_IMAGE=knowledgespike/acs-cricketarchive-api:latest
MARIADB_IMAGE=mariadb:11
NGINX_IMAGE=nginx:stable-alpine

# ---- Hostnames ----
# These must match your Cloudflare DNS records and nginx server_name directives
IDS_HOSTNAME=ids-beta.knowledgespike.cricket
ADMINUI_HOSTNAME=adminui-beta.knowledgespike.cricket
ACS_WEB_HOSTNAME=web-beta.knowledgespike.cricket
ACS_API_HOSTNAME=api-beta.knowledgespike.cricket

# ---- MariaDB ----
MARIADB_ROOT_PASSWORD=changeme_root_password
MARIADB_USER=acs_user
MARIADB_PASSWORD=changeme_db_password
MARIADB_DATABASE=identity
MARIADB_DATABASE_CONFIG=identity_config
MARIADB_DATABASE_GRANTS=identity_grants
MARIADB_DATABASE_KEYS=identity_keys

# ---- IdentityServer ----
IDS_PUBLIC_ORIGIN=https://ids-beta.knowledgespike.cricket
IDS_REQUIRE_SSL_METADATA_URL=true

# ---- AdminUI ----
ADMINUI_LICENSE_KEY=changeme_license_key

# ---- ACS ----
ACS_API_SECRET=changeme_api_secret

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=changeme_google_client_id
GOOGLE_CLIENT_SECRET=changeme_google_client_secret

# ---- Data Protection ----
# Certificate thumbprint for data protection keys encryption
DP_CERT_THUMBPRINT=changeme_cert_thumbprint

# ---- TLS Certificates ----
# Path to origin TLS certificate and key (relative to compose file)
TLS_CERT_PATH=/etc/letsencrypt/live/beta/server.crt
TLS_KEY_PATH=/etc/letsencrypt/live/beta/server.key

# ---- Timezone ----
TZ=UTC
