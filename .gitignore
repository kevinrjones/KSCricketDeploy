# Environment files with secrets
.env
environments/**/.env

# Secrets — keep README / cheatsheet; ignore real per-env secret file bodies
private/.secrets
private/local-vm/**
!private/local-vm/.gitkeep
private/beta/**
!private/beta/.gitkeep
# Allow documentation under private/
!private/README.md
!private/.secret-names

# TLS certificates + DP PFX
certs/**/*.crt
certs/**/*.key
certs/**/*.pem
certs/**/*.pfx

# Backup files
*.sql
*.sql.gz
backups/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
