# =============================================================================
# Reference Cheatsheet: Secret Files in private/<env>/
# Note: Docker Compose does NOT read this file.
# Real secrets are stored as individual files under private/local-vm/ and private/beta/.
# =============================================================================

# MariaDB Passwords (password text only in each file)
mariadb_root_password=<random root password>
mariadb_password=<password for identity user>

# IdentityServer Secrets
# Beta compose mounts the MailKit files below into the ids service; local-vm
# does not require them unless its compose file is changed to mount them.
ConnectionStrings__identity=server=mariadb;database=identity;user=identity;password=<mariadb_password>;Command Timeout=180
DataProtection__Certificate__Password=<password for certs/<env>/ids-mysql-dp.pfx>
Authentication__Google__ClientId=<Google OAuth client id>
Authentication__Google__ClientSecret=<Google OAuth client secret>
MailKit__SmtpServer=smtp.gmail.com
MailKit__Port=587
MailKit__Username=<SMTP username>
MailKit__Password=<SMTP password or app password>

# AdminUI Secrets
LicenseKey=<Duende AdminUI license text>
AdminUIClientSecret=Dev
UsernamePolicy__Secret=<random hex string>
IdentityConnectionString=server=mariadb;database=identity;user=identity;password=<mariadb_password>;Command Timeout=180
IdentityServerConnectionString=server=mariadb;database=identity;user=identity;password=<mariadb_password>;Command Timeout=180

# ACS & BBB API Database Credentials
jdbc.username=cricketarchive
jdbc.password=<password for cricketarchive user>
