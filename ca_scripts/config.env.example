# Copy this file to ca_scripts/config.env and edit it for the machine running
# the scripts. This example targets the Beta Docker MariaDB published on the
# VPS loopback interface; it does not contain credentials.

# Data and output locations
CA_ARCHIVE_DIR=$HOME/cricket/CricketArchive/Archive
CA_DUMP_DIR=$HOME/sql
CA_DUMP_FILE=$HOME/sql/cricketarchive-beta.sql.gz

# Host-side JDBC connection to the Beta Docker MariaDB service.
# Beta Compose maps 127.0.0.1:3307 on the VPS to mariadb:3306.
CA_DB_HOST=127.0.0.1
CA_DB_PORT=3307
CA_DB_NAME=cricketarchive
# When this tree is installed at /home/kevin/cron, use absolute paths instead:
# CA_DB_USER_FILE=/home/kevin/acs-deploy/private/beta/jdbc.username
# CA_DB_PASSWORD_FILE=/home/kevin/acs-deploy/private/beta/jdbc.password
# The relative values below are correct when config.env is under
# ~/acs-deploy/ca_scripts.
CA_DB_USER_FILE=../private/beta/jdbc.username
CA_DB_PASSWORD_FILE=../private/beta/jdbc.password

# Optional: fetch credentials and proxy settings. Prefer credentials.env for
# these values so config.env can remain non-sensitive.
# CRICKETARCHIVE_EMAIL=
# CRICKETARCHIVE_PASSWORD=
# CRICKETARCHIVE_PROXY_HOST=
# CRICKETARCHIVE_PROXY_PORT=
# CRICKETARCHIVE_PROXY_USER=
# CRICKETARCHIVE_PROXY_PASSWORD=

# Optional mail notification password used by the Java applications when their
# email appender is enabled. Leave unset unless notifications are required.
# GMAIL_ACCT_PASSWORD=